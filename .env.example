# Copy to .env. Read by the server at startup (process.loadEnvFile).
# Claude Code model alias or full id used for "Curate with Claude": sonnet | opus | haiku
CURATE_MODEL=sonnet
# Effort level passed to claude -p: low | medium | high
CURATE_EFFORT=medium
# Seconds to wait for one curate run
CURATE_TIMEOUT=600

# Workers KV namespace id for the CACHE binding (cf kv namespaces list), read by cloudflare.config.ts at deploy
CACHE_KV_ID=
